# Forzar terminación de línea CRLF para todos los archivos de texto en Windows
* text=auto eol=crlf

# Archivos de script POSIX / shell que requieren estrictamente LF
*.sh text eol=lf

# Archivos binarios que no deben modificarse
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
